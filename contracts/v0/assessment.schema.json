{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standard2shape.dev/contracts/v0/assessment.schema.json",
  "title": "standard2shape validation assessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentVersion",
    "package",
    "reasoningProfile",
    "evaluator",
    "startedAt",
    "completedAt",
    "results"
  ],
  "properties": {
    "assessmentVersion": { "const": "0.1" },
    "package": { "$ref": "#/$defs/packageRef" },
    "reasoningProfile": { "$ref": "#/$defs/profileRef" },
    "evaluator": { "$ref": "#/$defs/profileRef" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "iri": { "type": "string", "format": "iri", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?:[^./\\\\][^/\\\\]*|\\.[^./\\\\][^/\\\\]*|\\.\\.[^/\\\\]+)(?:/(?:[^./\\\\][^/\\\\]*|\\.[^./\\\\][^/\\\\]*|\\.\\.[^/\\\\]+))*$" },
    "timestamp": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?Z$" },
    "check": {
      "enum": [
        "syntax",
        "package-structure",
        "shacl",
        "reasoning-profile",
        "semantic-applicability",
        "quantitative-applicability",
        "test-vectors"
      ]
    },
    "conformance": { "enum": ["conforms", "non-conforms"] },
    "outcome": { "enum": ["conforms", "non-conforms", "evaluator-failure", "unsupported", "indeterminate"] },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/iri" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/iri" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "severity", "message"],
      "properties": {
        "requirement": { "$ref": "#/$defs/iri" },
        "severity": { "enum": ["violation", "warning", "info"] },
        "message": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "focus": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/path" }
      }
    },
    "vectorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/iri" },
        "expected": { "$ref": "#/$defs/conformance" },
        "actual": { "$ref": "#/$defs/conformance" }
      }
    },
    "requirementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/iri" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "hasBlockingViolation": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "severity": { "const": "violation" } },
        "required": ["severity"]
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "outcome", "violations", "evidenceChecked"],
      "properties": {
        "check": { "$ref": "#/$defs/check" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "requirement": { "$ref": "#/$defs/requirementRef" },
        "message": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/violation" }
        },
        "evidenceChecked": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "vector": { "$ref": "#/$defs/vectorResult" }
      },
      "allOf": [
        {
          "if": { "properties": { "check": { "const": "test-vectors" } } },
          "then": { "required": ["vector"] },
          "else": { "not": { "required": ["vector"] } }
        },
        {
          "if": { "properties": { "check": { "enum": ["semantic-applicability", "quantitative-applicability"] } } },
          "then": { "required": ["requirement"] }
        },
        {
          "if": { "properties": { "check": { "enum": ["syntax", "package-structure", "reasoning-profile", "test-vectors"] } } },
          "then": { "not": { "required": ["requirement"] } }
        },
        {
          "if": { "properties": { "check": { "enum": ["syntax", "package-structure", "shacl", "reasoning-profile", "test-vectors"] } } },
          "then": { "properties": { "outcome": { "not": { "const": "indeterminate" } } } }
        },
        {
          "if": { "properties": { "outcome": { "enum": ["evaluator-failure", "unsupported", "indeterminate"] } } },
          "then": {
            "required": ["message"],
            "properties": {
              "violations": { "maxItems": 0 },
              "vector": { "not": { "required": ["actual"] } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": { "const": "conforms" },
              "check": { "not": { "const": "test-vectors" } }
            }
          },
          "then": { "properties": { "violations": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": {
              "outcome": { "const": "non-conforms" },
              "check": { "not": { "const": "test-vectors" } }
            }
          },
          "then": { "properties": { "violations": { "$ref": "#/$defs/hasBlockingViolation" } } }
        },
        {
          "if": {
            "properties": {
              "outcome": { "enum": ["conforms", "non-conforms"] },
              "check": { "const": "test-vectors" }
            }
          },
          "then": { "properties": { "vector": { "required": ["actual"] } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "actual": { "const": "conforms" } }, "required": ["actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "violations": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "actual": { "const": "non-conforms" } }, "required": ["actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "violations": { "$ref": "#/$defs/hasBlockingViolation" } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "expected": { "const": "conforms" }, "actual": { "const": "conforms" } }, "required": ["expected", "actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "outcome": { "const": "conforms" } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "expected": { "const": "conforms" }, "actual": { "const": "non-conforms" } }, "required": ["expected", "actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "outcome": { "const": "non-conforms" } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "expected": { "const": "non-conforms" }, "actual": { "const": "conforms" } }, "required": ["expected", "actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "outcome": { "const": "non-conforms" } } }
        },
        {
          "if": {
            "properties": { "vector": { "properties": { "expected": { "const": "non-conforms" }, "actual": { "const": "non-conforms" } }, "required": ["expected", "actual"] } },
            "required": ["vector"]
          },
          "then": { "properties": { "outcome": { "const": "conforms" } } }
        }
      ]
    }
  }
}
